        <table class="lp-company-table">
          <tbody>
            <tr>
              <th>会社名</th>
              <td>MeRock</td>
            </tr>
            <tr>
              <th>サービス内容</th>
              <td>AI活用DX支援 / マーケ支援 / ブランディングコンサル</td>
            </tr>
            <tr>
              <th>お問い合わせ</th>
              <td><a href="mailto:contact@merock.co">contact@merock.co</a></td>
            </tr>
            <tr>
              <th>Webサイト</th>
              <td><a href="https://merock.co" target="_blank">merock.co</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
