          <p class="lp-price-desc">動画編集は1本数万円からでも対応可能。SNS運用もご相談ください。</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="lp-price-card">
          <div class="lp-price-icon">✨</div>
          <h4 class="lp-price-name">ブランディングコンサル</h4>
          <p class="lp-price-amount">1時間〜 相談可</p>
          <p class="lp-price-desc">顧客やファンを増やすために何を伝えたいか、まず1時間のご相談から。</p>
        </div>
      </div>
    </div>
    <p class="text-center mt-4 fw-bold" style="font-size:1.1rem;">まずはお気軽に無料相談から！</p>
  </div>
</section>

<%# ⑧ お問い合わせフォーム %>
<section class="lp-section lp-contact" id="contact">
  <div class="container">
    <h2 class="lp-section-title text-center mb-2">無料相談・お問い合わせ</h2>
    <p class="text-center text-muted mb-5">まずはお気軽にご相談ください。通常2営業日以内にご連絡いたします。</p>
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <%= form_with url: contacts_path, method: :post, local: true, class: "lp-contact-form" do |f| %>
          <div class="mb-3">
            <%= f.label :name, "お名前 *", class: "form-label" %>
            <%= f.text_field :name, class: "form-control", placeholder: "山田 太郎", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :company, "会社名", class: "form-label" %>
            <%= f.text_field :company, class: "form-control", placeholder: "株式会社〇〇" %>
          </div>
          <div class="mb-3">
            <%= f.label :email, "メールアドレス *", class: "form-label" %>
            <%= f.email_field :email, class: "form-control", placeholder: "your@email.com", required: true %>
          </div>
          <div class="mb-4">
            <%= f.label :description, "お悩み・ご相談概要 *", class: "form-label" %>
            <%= f.text_area :description, class: "form-control", rows: 4, placeholder: "例：社内の見積書作成を自動化したい、SNS運用を始めたい など", required: true %>
          </div>
          <%= f.submit "無料相談を申し込む →", class: "btn lp-btn-primary w-100 lp-btn-lg" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

