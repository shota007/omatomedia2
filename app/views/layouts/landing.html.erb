<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
  <link rel="icon" type="image/png" href="/favicon.ico" sizes="16x16">
  <title>MeRock | AI × クリエイティブで、あなたのビジネスを加速させる。</title>
</head>
<body>

  <!-- ナビゲーション -->
  <nav class="navbar navbar-expand-md fixed-top lp-nav">
    <div class="container">
      <a class="navbar-brand lp-brand" href="/">MeRock</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#lpNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="lpNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="#services">サービス</a></li>
          <li class="nav-item"><a class="nav-link" href="#why-us">選ばれる理由</a></li>
          <li class="nav-item"><a class="nav-link" href="#cases">実績</a></li>
          <li class="nav-item"><a class="nav-link" href="#pricing">料金</a></li>
          <li class="nav-item"><a class="nav-link" href="#company">会社概要</a></li>
        </ul>
        <a href="#contact" class="btn lp-btn-primary ms-3">無料相談する</a>
      </div>
    </div>
  </nav>

  <!-- フラッシュメッセージ -->
  <% flash.each do |type, msg| %>
    <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show lp-flash" role="alert">
      <%= msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <%= yield %>

  <!-- フッター -->
  <footer class="lp-footer">
    <div class="container text-center">
      <p class="mb-1" style="font-weight:700; font-size:1.1rem;">MeRock</p>
      <p class="mb-0" style="font-size:0.85rem; color:#aaa;">&copy; <%= Date.current.year %> MeRock. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>
