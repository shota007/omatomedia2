<!DOCTYPE html>
<html lang="ja" data-bs-theme="auto" >

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <script src="https://kit.fontawesome.com/4535843fc0.js" crossorigin="anonymous"></script>
  <link rel="icon" type="image/png" href="/favicon.ico" sizes="16x16">
  <title>Omatomedia</title>
</head>

<body class="wrapper">

    <% if current_page?(login_path)||current_page?(new_user_path) %>
      <div class="d-flex align-items-center justify-content-center text-center">
        <%= yield %>
      </div>
    <% else %>
    <%# nav bar %>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark" aria-label="Fourth navbar example">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">omatomedia</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarsExample04" aria-controls="navbarsExample04" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarsExample04">
          <ul class="navbar-nav me-auto mb-2 mb-md-0">
            <%# <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Dropdown</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">Action</a></li>
                <li><a class="dropdown-item" href="#">Another action</a></li>
                <li><a class="dropdown-item" href="#">Something else here</a></li>
              </ul>
            </li> %>
          </ul>
          <div>
              <% if logged_in? %>
                <div class="dropdown">
                  <a href="/" class="d-flex align-items-center link-body-emphasis text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="me-2">
                      <% if current_user.avatar.attached? %>
                        <%= image_tag(current_user.avatar, class: "rounded-circle") %>
                      <% else %>
                        <%= image_tag("noimage.png", size: "32x32", class: "rounded-circle") %>
                      <% end %>
                    </div>
                    <strong><%= current_user.name %></strong>
                  </a>
                  <ul class="dropdown-menu text-small shadow">
                    <li><%= link_to "My page", user_path(current_user), class: "dropdown-item" %></li>
                    <li><%= link_to "Sign Out", logout_path, class: "dropdown-item", data: { turbo_method: :delete } %></li>
                  </ul>
                </div>
              <% end %>
          </div>
        </div>
      </div>
    </nav>

  <div>

    <div>
      <%# deivseのフラッシュメッセージを表示 %>
      <% flash.each do |message_type, message| %>
        <div class="alert alert-<%= message_type %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </div>


  </div>

  <% end %>
</body>

<footer class="footer">
  <div class="container">
    <p class="text-muted text-center mt-2">all rights reserved by MeRock</p>
  </div>
</footer>

</html>
