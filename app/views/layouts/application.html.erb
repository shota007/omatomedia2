<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <script src="https://kit.fontawesome.com/4535843fc0.js" crossorigin="anonymous"></script>
  <link rel="icon" type="image/png" href="/favicon_miyacco.png" sizes="16x16">
  <title>Omatomedia</title>
</head>

<body>

  <% if current_page?(login_path) || current_page?(new_user_path) %>
    <%# ログイン・新規登録ページ：ナビなし・中央揃え %>
    <div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
      <%= yield %>
    </div>

  <% else %>
    <%# 通常ページ：ナビ + サイドバー + メインコンテンツ %>
    <%= render "shared/navbar" %>

    <div class="pt-navbar">
      <div class="app-container">
        <div class="row g-0">

          <%# サイドバー：md以上でのみ表示 %>
          <div class="d-none d-md-block col-md-2">
            <div class="sidebar-wrapper">
              <p class="sidebar-section-label">カテゴリ</p>
              <%= render "shared/categories_sidebar" %>
            </div>
          </div>

          <%# メインコンテンツ %>
          <div class="col-12 col-md-10">
            <div class="main-content px-3 py-3">

              <%# モバイル用カテゴリセレクト %>
              <div class="d-md-none mb-3">
                <select class="form-select form-select-sm" onchange="location.href=this.value">
                  <option value="<%= contents_path %>">📂 すべてのカテゴリ</option>
                  <% @categories.each do |c| %>
                    <option value="<%= contents_path(category_id: c.id) %>"
                            <%= 'selected' if params[:category_id].to_i == c.id %>>
                      <%= c.name %>
                    </option>
                  <% end %>
                </select>
              </div>

              <%# フラッシュメッセージ %>
              <% flash.each do |message_type, message| %>
                <div class="alert alert-<%= message_type %> alert-dismissible fade show" role="alert">
                  <%= message %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="閉じる"></button>
                </div>
              <% end %>

              <%= yield %>
            </div>
          </div>

        </div>
      </div>

      <footer class="footer mt-5 py-3 bg-light border-top">
        <div class="text-center">
          <small class="text-muted">© Omatomedia. All rights reserved.</small>
        </div>
      </footer>
    </div>

  <% end %>

</body>
</html>
